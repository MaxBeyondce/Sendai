# 含個資，絕對不能進公開 repo
# 注意：.gitignore 不支援行尾註解，說明一律另起一行，否則整行會被當成比對樣式
private/

# 抽取原貌，含姓名、訂位代號、租車號碼、人數
trip_data.json

# 行程內容(每一站的名稱、地址、備註)。這是資料不是設定，
# 留在公開 repo 等於繞過 docs/index.html 的加密。
clusters.json

# 完整版產出
index_mobile.html

# 建置素材（圖片已內嵌進 docs/index.html，不需另外進 repo）
assets/

# 待加密的明文公開版
build/

# 加密流程的暫存與測試鷹架（可自行刪除）
tools/_*

# 來源檔（v3 說明 md、購物清單 html）已搬進 private/raw/。
# 這一行是防呆：萬一 raw/ 又被建回根目錄，也不會因為少寫一行而漏出去。
raw/

# 由工具產生的行程內容：地名與座標、逐點說明、購物品項。
# 跟 clusters.json 同理 — 這是資料不是設定，留在公開 repo 等於繞過加密。
places.json
guide.json
guide_overrides.json
shopping.json
shopping_overrides.json

# 一般
__pycache__/
*.pyc
.venv/
.DS_Store
.claude/
